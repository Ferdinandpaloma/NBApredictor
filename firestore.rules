rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own bets.
    match /users/{uid}/bets/{betId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['pid', 'date', 'stat', 'line', 'side', 'odds', 'stake'])
        && request.resource.data.side in ['over', 'under']
        && request.resource.data.stake is number && request.resource.data.stake > 0;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
